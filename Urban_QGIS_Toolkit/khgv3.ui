                <string notr="true">QGroupBox {
    background-color: rgb(255, 255, 255);
    border: 1px solid rgb(200, 200, 210);
    border-radius: 10px;
    margin-top: 10px;
    padding-top: 8px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: rgb(45, 52, 66);
}
QPushButton[k_role="primary"] {
    color: rgb(255, 255, 255);
    background-color: rgb(42, 120, 214);
    border: 1px solid rgb(255, 255, 255);
    border-radius: 10px;
    padding: 7px 12px;
}
QPushButton[k_role="primary"]:hover { background-color: rgb(77, 143, 226); }
QPushButton[k_role="primary"]:pressed { background-color: rgb(32, 93, 169); }
QPushButton[k_role="primary"]:disabled { background-color: rgb(178, 187, 199); }
QPushButton[k_role="secondary"] {
    color: rgb(42, 120, 214);
    background-color: rgb(255, 255, 255);
    border: 1px solid rgb(42, 120, 214);
    border-radius: 10px;
    padding: 7px 12px;
}
QPushButton[k_role="secondary"]:hover { background-color: rgb(234, 243, 255); }
QPushButton[k_role="secondary"]:pressed { background-color: rgb(214, 231, 252); }
QPushButton[k_role="secondary"]:disabled {
    color: rgb(145, 151, 163);
    border-color: rgb(178, 187, 199);
}
QToolButton#btn_jibun_advanced { border: none; color: rgb(42, 120, 214); padding: 3px; }
QLabel[k_role="hint"] { color: rgb(85, 93, 109); }
QComboBox QAbstractItemView {
    background-color: rgb(255, 255, 255);
    color: rgb(45, 52, 66);
    selection-background-color: rgb(214, 226, 242);
    selection-color: rgb(45, 52, 66);
}</string>

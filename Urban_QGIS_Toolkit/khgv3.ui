                 <property name="styleSheet">
                  <string notr="true">/* 1. 기본 상태 */
QPushButton {
    color: rgb(255, 255, 255);
    background-color:  rgb(42,120,214);
    border: 1px solid rgb(255, 255, 255);
    border-radius: 10px;
    padding: 1px 1px;                    /*여백*/
}

/* 2. 마우스를 올렸을 때 (Hover) */
QPushButton:hover {
    background-color: rgb(109, 167, 242,0.2); /* 원래 색상보다 약간 밝게 */
}

/* 3. 버튼을 클릭했을 때 (Pressed) - 애니메이션 효과 대체 */
QPushButton:pressed {
    background-color: rgb(160, 196, 242);  /* 원래 색상보다 어둡게 해서 눌린 느낌 전달 */
    border: 2px solid rgb(50, 50, 50);  /* 테두리를 두껍게 하거나 선 색상을 어둡게 */
    padding-left: 3px;                    /* 텍스트가 미세하게 움직이는 효과 (선택사항) */
    padding-top: 3px;
}</string>
                 </property>
